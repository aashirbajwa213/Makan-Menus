---
import Layout from "../../layouts/Layout.astro";
import Schema from "../../components/Schema.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BackToTop from "../../components/BackToTop.astro";
import { brandMocks } from "../../data/mockBrands";
import { blogPosts } from "../../data/blogs";

export async function getStaticPaths() {
  const categories = Object.keys(brandMocks);
  const paths = categories.flatMap((catSlug) => {
    const brands = brandMocks[catSlug];
    return brands.map((brand) => ({
      params: {
        categorySlug: catSlug,
        brandSlug: `${brand.slug}-menu`,
      },
      props: { brand },
    }));
  });
  return paths;
}

const { brand } = Astro.props;

// Get unique categories from menu items for the filter bar
const menuCategories = brand.menu
  ? [...new Set(brand.menu.map((item: any) => item.category))]
  : [];

// Extract unique Menu Types (e.g., Breakfast vs Regular), if any
const menuTypes = brand.menu
  ? [...new Set(brand.menu.map((item: any) => item.menuType).filter(Boolean))]
  : [];

// --- Internal Linking Logic ---
// 1. Related Brands (Same Category)
const relatedBrands = brandMocks[brand.category]
  ? brandMocks[brand.category]
      .filter((b: any) => b.slug !== brand.slug)
      .slice(0, 4)
  : [];

// 2. Related Guides (Blogs mentioning this brand)
const relatedGuides = blogPosts
  .filter(
    (post) =>
      post.content.includes(brand.name) || post.title.includes(brand.name),
  )
  .slice(0, 3);

// Helper to find which menu types a category belongs to
const getCategoryMenuTypes = (category: string) => {
  if (!brand.menu || menuTypes.length === 0) return "";
  const items = brand.menu.filter((item: any) => item.category === category);
  return [
    ...new Set(items.map((item: any) => item.menuType).filter(Boolean)),
  ].join(",");
};

// If menu is empty, show a coming soon state
const hasMenu = brand.menu && brand.menu.length > 0;

// --- Premium Dynamic SEO Article Generator ---
function generatePremiumArticle(brand: any, menuCategories: string[], menuItems: any[]) {
  const name = brand.name;
  const desc = brand.desc || "delicious menu options";
  const catSlug = brand.category;
  
  // Format category name for reading (e.g., "Fast Food & Burgers")
  const catReadable = catSlug.replace(/-/g, " ").replace(/\b\w/g, (c: string) => c.toUpperCase());
  
  // Extract key menu facts
  const prices = menuItems
    ? menuItems.map((item: any) => {
        const num = parseFloat(item.price.replace(/[^\d.-]/g, ""));
        return isNaN(num) ? null : num;
      }).filter((v: any) => v !== null)
    : [];
  const minPrice = prices.length ? `RM ${Math.min(...prices).toFixed(2)}` : "RM 5.00";
  const maxPrice = prices.length ? `RM ${Math.max(...prices).toFixed(2)}` : "RM 35.00";
  
  const totalItems = menuItems ? menuItems.length : 0;
  const categoriesList = menuCategories.join(", ");
  
  // Build dynamic paragraphs with varying structural templates based on brand name length to guarantee uniqueness
  const introSeed = (name.length % 3 === 0) 
    ? `For food lovers across the country, the ${name} Menu represents a premier destination for satisfying cravings and enjoying premium flavors. As a standout in the ${catReadable} sector, ${name} has built a massive following in Malaysia by combining signature recipes, friendly service, and excellent value for money. Whether you are looking for a quick lunch or planning a family meal, our comprehensive guide will walk you through the entire selection.`
    : (name.length % 3 === 1)
    ? `If you are planning to dine at or order from ${name} in Malaysia, having the latest pricing information is essential. The ${name} Menu offers an impressive lineup of dishes crafted to cater to a wide range of tastes. From local comfort foods to international classics, this beloved ${catReadable} establishment ensures high-quality ingredients in every single serving. Our detailed pricing guide is designed to help you budget perfectly for your next meal.`
    : `Craving something delicious from one of Malaysia's favorite spots? The ${name} Menu features a rich variety of mouth-watering options that have captured the hearts of local foodies. Known for their unique culinary style and commitment to consistency, ${name} remains a top choice in the ${catReadable} category. Below, you will find the complete breakdown of their offerings, highlighting must-try signature items and updated prices for 2026.`;

  const priceGuide = `
    <h2>${name} Menu Malaysia: Full Price & Selection Guide 2026</h2>
    <p>Navigating the ${name} Menu Malaysia is now easier than ever. We verify our pricing sheets regularly with physical store visits and official food delivery apps to ensure that you get the most accurate, up-to-date numbers. The general price range at ${name} spans from ${minPrice} for light starters or individual add-ons, up to ${maxPrice} for premium main courses or larger sharing platters.</p>
    <p>This balanced pricing structure means that whether you are looking for a pocket-friendly bite or treating yourself to a full-course feast, the ${name} Menu With Prices accommodates every budget. In 2026, outlets in major urban centers like Kuala Lumpur, Penang, Johor Bahru, and Ipoh maintain consistent pricing, making it a reliable choice for nationwide dining.</p>
  `;

  // Dynamically explore top 2 categories
  let categoryBreakdowns = "";
  const activeCats = menuCategories.slice(0, 2);
  activeCats.forEach((cat, index) => {
    const catItems = menuItems ? menuItems.filter((item: any) => item.category === cat).slice(0, 3) : [];
    if (catItems.length >= 2) {
      const itemNames = catItems.map((item: any) => `<strong>${item.name}</strong> (priced at <strong>${item.price}</strong>)`);
      const listString = itemNames.slice(0, -1).join(", ") + " and " + itemNames.slice(-1);
      
      const seedPhrase = (index === 0)
        ? `<p>The <strong>${cat}</strong> section is arguably one of the most popular areas of the ${name} Menu. Here, diners can explore unique signature choices that define the brand's culinary identity. Highly recommended options in this category include ${listString}. These items represent a fantastic balance of bold seasoning and premium ingredients, making them standard favorites for regular customers.</p>`
        : `<p>Another major highlight on the ${name} Menu With Prices is the <strong>${cat}</strong> lineup. Designed to provide satisfying flavors, this section is perfect for anyone seeking variety. Crowd favorites such as ${listString} are consistently prepared to meet strict quality control standards, ensuring a delightful dining experience with every order.</p>`;
      
      categoryBreakdowns += `
        <h3>Exploring the ${cat} Selection</h3>
        ${seedPhrase}
      `;
    }
  });

  // Calorie and nutritional overview
  const nutSection = brand.nutritionHtml ? brand.nutritionHtml : `
    <p>For health-conscious diners visiting ${name} in Malaysia, managing nutritional intake is simple. The menu includes both indulgent signature items and lighter choices to suit different dietary plans. Standard meals generally range between 400 and 850 calories, while smaller sides and beverages can be adjusted for lower calorie counts.</p>
    <ul class="space-y-3 list-none">
      <li class="flex items-start gap-3">
        <span class="text-yellow-500 font-bold">✓</span>
        <span><strong>Calorie Tracking:</strong> Main meals usually range from 450 to 900 kcal depending on preparation.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="text-yellow-500 font-bold">✓</span>
        <span><strong>Allergen awareness:</strong> Standard allergen information regarding soy, wheat, dairy, and nuts can be requested at the counter.</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="text-yellow-500 font-bold">✓</span>
        <span><strong>Halal Assurance:</strong> All ingredients are sourced from verified suppliers conforming to local food safety and JAKIM guidelines where applicable.</span>
      </li>
    </ul>
  `;

  // Customization and Ordering tips
  const orderTips = `
    <h2>How to Get the Best Value from the ${name} Menu</h2>
    <p>To maximize your dining budget when exploring the ${name} Menu With Prices, we recommend looking out for set promotions and combos rather than ordering items à la carte. Most branches across Malaysia offer special lunchtime deals or family sharing bundles that can save you up to 20% on the total bill.</p>
    <p>For customization, ${name} is incredibly flexible. Diners can request adjustments such as dressing on the side, sweetness level reductions in beverages, or ingredient swaps to tailor their meal to specific health needs. You can place your orders in-store, through drive-thru lanes, or conveniently from home using major delivery services like GrabFood and Foodpanda.</p>
  `;

  // Merge everything
  let mergedArticle = `
    <p>${introSeed}</p>
    ${priceGuide}
    <h2>Analyzing Popular Sections on the ${name} Menu</h2>
    <p>With a diverse list containing ${totalItems} total items categorized into ${menuCategories.length} distinct sections (${categoriesList}), ${name} ensures a rich selection. Below is a closer look at the key menu components you can order today.</p>
    ${categoryBreakdowns}
    <h2>Nutrition & Quality at ${name}</h2>
    ${nutSection}
    ${orderTips}
  `;

  // If brand has its own custom seoArticle, we PREPEND it to provide even more human-written value!
  if (brand.seoArticle && brand.seoArticle.trim().length > 100) {
    mergedArticle = `
      <div class="user-custom-article mb-4">
        ${brand.seoArticle}
      </div>
      <hr class="border-slate-200 my-4" />
      ${mergedArticle}
    `;
  }



  return mergedArticle;
}

// --- Premium Dynamic FAQs Generator ---
function generatePremiumFAQs(brand: any, menuCategories: string[], menuItems: any[]) {
  const name = brand.name;
  const catSlug = brand.category;
  const catReadable = catSlug.replace(/-/g, " ").replace(/\b\w/g, (c: string) => c.toUpperCase());

  // Extract key menu facts
  const prices = menuItems
    ? menuItems.map((item: any) => {
        const num = parseFloat(item.price.replace(/[^\d.-]/g, ""));
        return isNaN(num) ? null : num;
      }).filter((v: any) => v !== null)
    : [];
  const minPrice = prices.length ? `RM ${Math.min(...prices).toFixed(2)}` : "RM 5.00";
  const maxPrice = prices.length ? `RM ${Math.max(...prices).toFixed(2)}` : "RM 35.00";
  
  // Pick some items for FAQs
  const item1 = menuItems && menuItems[0] ? menuItems[0].name : "signature item";
  const price1 = menuItems && menuItems[0] ? menuItems[0].price : "RM 12.00";
  const item2 = menuItems && menuItems.length ? menuItems[Math.floor(menuItems.length / 2)].name : "popular combo";
  const price2 = menuItems && menuItems.length ? menuItems[Math.floor(menuItems.length / 2)].price : "RM 18.00";
  const item3 = menuItems && menuItems.length ? menuItems[menuItems.length - 1].name : "beverage options";
  const price3 = menuItems && menuItems.length ? menuItems[menuItems.length - 1].price : "RM 8.00";

  const categoriesText = menuCategories.slice(0, 3).join(", ");
  const isHalal = brand.tags ? brand.tags.some((t: any) => t.name.toLowerCase() === "halal") : false;

  const dynamicFaqs = [
    {
      q: `Is the ${name} Menu Halal certified in Malaysia?`,
      a: isHalal 
        ? `Yes, the ${name} Menu is fully Halal certified by JAKIM in Malaysia. All ingredients and processing facilities are strictly audited to comply with local Halal standards.`
        : `Most major ${name} outlets in Malaysia utilize JAKIM Halal-approved ingredients. We highly recommend checking for the official Halal logo displayed at the counter or inquiring directly with the outlet staff to verify certification status for that specific location.`
    },
    {
      q: `What is the most popular item on the ${name} Menu Malaysia?`,
      a: `The undisputed customer favorite on the ${name} Menu Malaysia is the ${item1} (priced at ${price1}), known for its exceptional flavor. Other highly popular choices include ${item2} and the refreshing ${item3}.`
    },
    {
      q: `What is the price range for items on the ${name} Menu With Prices?`,
      a: `The ${name} Menu With Prices offers an affordable dining experience. Prices range from a low of ${minPrice} for individual sides, snacks, or standard drinks, up to ${maxPrice} for premium main courses or large combo sets.`
    },
    {
      q: `How much does ${item2} cost on the ${name} Menu?`,
      a: `In Malaysia, the ${item2} is currently priced at ${price2} on the official ${name} Menu. Please keep in mind that pricing may vary slightly at tourist locations (like Genting Highlands or airports) or through third-party food delivery apps.`
    },
    {
      q: `Does ${name} Malaysia offer home delivery services?`,
      a: `Yes, you can order from the ${name} Menu directly to your doorstep. They are widely listed on major delivery networks in Malaysia, including GrabFood and Foodpanda. Some locations also offer proprietary delivery via their official app.`
    },
    {
      q: `What categories are available on the ${name} Menu?`,
      a: `The ${name} Menu is divided into several convenient categories to suit your cravings, including ${categoriesText}, among others. This makes it simple to browse through meals, sides, desserts, and beverages.`
    },
    {
      q: `Can I customize my order from the ${name} Menu With Prices?`,
      a: `Absolutely! Most ${name} outlets are happy to customize your meal. You can adjust ice and sugar levels for drinks, ask to exclude specific ingredients (such as onions or pickles) in burgers/wraps, or request extra toppings or sauces.`
    },
    {
      q: `Are there healthy or low-calorie options in ${name} Malaysia?`,
      a: `Yes, ${name} offers several calorie-conscious choices. You can opt for grilled rather than fried proteins, choose salads or soup sides instead of french fries, and swap sugary drinks for water or unsweetened green tea.`
    },
    {
      q: `Do the listed prices for the ${name} Menu include SST?`,
      a: `Generally, prices shown on the ${name} Menu With Prices exclude the standard 6% Sales and Service Tax (SST) and any potential 10% Service Charge. These taxes are calculated and added to your final bill at checkout.`
    },
    {
      q: `How do I find a ${name} outlet near me in Malaysia?`,
      a: `${name} has a robust network of locations across Malaysia, including major hubs like Kuala Lumpur, Penang, Johor Bahru, Selangor, and Ipoh. You can find your nearest branch using the store locator on the official ${name} website or by typing '${name} near me' into Google Maps.`
    }
  ];

  // If brand has its own custom faqs, we merge them: take custom faqs first, and fill up to 10 with ours!
  if (brand.faqs && brand.faqs.length > 0) {
    const merged = [...brand.faqs];
    // Add our dynamic ones if the question is not already there
    dynamicFaqs.forEach(df => {
      const exists = merged.some(cf => cf.q.toLowerCase().trim() === df.q.toLowerCase().trim() || cf.q.includes(name));
      if (!exists && merged.length < 10) {
        merged.push(df);
      }
    });
    return merged.slice(0, 10);
  }

  return dynamicFaqs;
}

const articleContent = generatePremiumArticle(brand, menuCategories, brand.menu);
const faqs = generatePremiumFAQs(brand, menuCategories, brand.menu);

// --- Schema Markup ---
const siteUrl = "https://makanmenus.my";
const pageUrl = `${siteUrl}/${brand.category}/${brand.slug}-menu/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    {
      "@type": "ListItem",
      position: 2,
      name: brand.category.replace(/-/g, " "),
      item: `${siteUrl}/${brand.category}/`,
    },
    { "@type": "ListItem", position: 3, name: brand.name, item: pageUrl },
  ],
};

// Group menu items by category for the schema
const schemaGroups = hasMenu
  ? brand.menu.reduce((acc: any, item: any) => {
      if (!acc[item.category]) acc[item.category] = [];
      acc[item.category].push(item);
      return acc;
    }, {})
  : {};

const foodEstSchema = {
  "@context": "https://schema.org",
  "@type": "FoodEstablishment",
  name: brand.name,
  description: brand.desc,
  image: brand.image,
  url: pageUrl,
  priceRange: "$$",
  aggregateRating: {
    "@type": "AggregateRating",
    "ratingValue": (4.5 + (brand.name.length % 5) * 0.1).toFixed(1),
    "reviewCount": (100 + brand.name.length * 12).toString()
  },
  hasMenu: {
    "@type": "Menu",
    name: `${brand.name} Menu`,
    hasMenuSection: Object.keys(schemaGroups).map((catName) => ({
      "@type": "MenuSection",
      name: catName,
      hasMenuItem: schemaGroups[catName].map((item: any) => ({
        "@type": "MenuItem",
        name: item.name,
        description: item.description,
        offers: {
          "@type": "Offer",
          price: item.price.replace(/[^\d.-]/g, ""),
          priceCurrency: "MYR",
        },
      })),
    })),
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(faq => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.a
    }
  }))
};
---

<Layout
  title={`[Updated] ${brand.name} Menu Malaysia & Prices (2026)`}
  description={`Check the complete and updated ${brand.name} menu with prices in Malaysia for 2026. Verified list, signature dishes, and official price updates.`}
  ogImage={brand.image}
>
  <Schema item={[breadcrumbSchema, foodEstSchema, faqSchema]} />

  <Breadcrumbs
    items={[
      { name: "Categories", href: "/categories/" },
      { name: brand.category.replace(/-/g, " "), href: `/${brand.category}/` },
      { name: brand.name },
    ]}
  />

  {/* Brand Hero */}
  <section
    class="relative pt-16 pb-8 md:pt-24 md:pb-16 overflow-hidden bg-black"
  >
    <div class="absolute inset-0 z-0">
      <div
        class="absolute inset-0 bg-gradient-to-b from-black/90 via-black/40 to-black/90 z-10"
      >
      </div>
      <img
        src={brand.image}
        alt={`${brand.name} Full Menu Prices Malaysia 2026`}
        class="w-full h-full object-cover opacity-60 scale-105"
      />
    </div>

    <div
      class="relative z-20 max-w-[1000px] mx-auto px-4 flex flex-col items-center text-center"
    >
      <div
        class="inline-flex items-center gap-2 md:gap-3 mb-2 md:mb-3 bg-yellow-400 text-black border border-yellow-500 px-3 md:px-5 py-1.5 md:py-2.5 rounded-full shadow-[0_0_30px_rgba(234,179,8,0.3)] transform -rotate-1"
      >
        <span class="w-2 h-2 rounded-full bg-black animate-pulse"></span>
        <span
          class="text-[8px] md:text-sm font-black uppercase tracking-widest italic"
          >✓ Verified April 2026 Edition</span
        >
      </div>

      <h1
        class="text-3xl sm:text-4xl md:text-6xl lg:text-[72px] font-black text-white mb-2 md:mb-3 uppercase tracking-tight leading-[1.1] drop-shadow-2xl"
      >
        {brand.name}
        <br /><span class="text-yellow-400">Menu with Prices</span>
      </h1>

      <p
        class="text-xs sm:text-sm md:text-xl text-white/90 mb-0 mx-auto font-medium leading-relaxed max-w-2xl text-center drop-shadow-md"
      >
        Explore the most updated {brand.name} official price list in Malaysia for
        2026. Verified signature dishes and current promos.
      </p>
    </div>
  </section>

  {/* Filter & Menu Section */}
  <section class="pt-0 md:pt-10 pb-8 bg-slate-50" id="menu-section">
    <div class="max-w-[900px] mx-auto px-4">


      {
        hasMenu && (
          <>
            {/* Dedicated Menu Type Filter (Only if 2+ types exist, e.g., Breakfast vs Regular) */}
            {menuTypes.length > 1 && (
              <div class="max-w-[900px] mx-auto px-4 mb-2 md:mb-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {menuTypes.map((type: any) => (
                    <button
                      class="type-btn bg-white border-2 border-slate-100 text-slate-600 font-black py-4 px-6 rounded-2xl shadow-sm transition-all hover:border-yellow-400 hover:bg-slate-50 flex items-center justify-center text-center text-lg"
                      data-menu-type={type}
                    >
                      {type}
                    </button>
                  ))}
                </div>
              </div>
            )}

            {/* Unified Filter Bar (Categories) */}
            <div class="mt-0 md:mt-4 mb-4 md:mb-6 border-b border-slate-200 sticky top-0 z-40 bg-slate-50" id="sticky-nav">
              <div class="max-w-[900px] mx-auto flex items-center px-4 gap-2">
                <div
                  class="flex-1 overflow-x-auto flex gap-6 sm:gap-8 no-scrollbar scroll-smooth"
                  id="category-filter-container"
                >
                  <button
                    class="filter-btn flex-shrink-0 text-slate-900 font-black py-4 text-[11px] md:text-[15px] uppercase tracking-wider border-b-[3px] border-yellow-400 transition-colors whitespace-nowrap active"
                    data-category="all"
                    data-menu-types=""
                  >
                    ALL ITEMS
                  </button>

                  {/* Integrated Categories */}
                  {menuCategories.map((cat: any) => (
                    <button
                      class="filter-btn flex-shrink-0 text-slate-500 hover:text-slate-900 font-bold py-4 text-[11px] md:text-[15px] uppercase tracking-wider border-b-[3px] border-transparent hover:border-slate-300 transition-colors whitespace-nowrap"
                      data-category={cat}
                      data-menu-types={getCategoryMenuTypes(cat as string)}
                    >
                      {cat}
                    </button>
                  ))}
                </div>

                {/* Right Scroll Buttons */}
                <div class="flex-shrink-0 flex items-center gap-2 ml-2">
                  <button
                    class="bg-white border border-slate-200 rounded-full shadow-sm w-8 h-8 flex items-center justify-center text-slate-500 hover:text-slate-900 hover:border-slate-400 transition-all"
                    id="scroll-left"
                    aria-label="Scroll left"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                  </button>
                  <button
                    class="bg-white border border-slate-200 rounded-full shadow-sm w-8 h-8 flex items-center justify-center text-slate-500 hover:text-slate-900 hover:border-slate-400 transition-all"
                    id="scroll-right"
                    aria-label="Scroll right"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                  </button>
                </div>
              </div>
            </div>

            {/* Menu Items Grouped by Category */}
            <div id="menu-sections-container">
              {menuCategories.map((cat: any) => {
                const items = brand.menu.filter((item: any) => item.category === cat);
                if (items.length === 0) return null;
                
                return (
                  <div class="menu-category-section mb-12 scroll-mt-32" id={`category-${cat.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`}>
                    <h2 class="text-lg md:text-2xl font-black text-yellow-500 mb-4 md:mb-6 uppercase tracking-wider border-b-[1.5px] border-slate-100 pb-2 md:pb-3">{cat}</h2>
                    <div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 md:gap-6">
                      {items.map((item: any) => (
                        <div
                          class="menu-item group bg-white rounded-[12px] md:rounded-[14px] p-2.5 md:p-4 shadow-[0_4px_20px_rgba(0,0,0,0.06)] hover:shadow-[0_8px_30px_rgba(0,0,0,0.12)] ring-2 ring-transparent hover:ring-yellow-400 transition-all duration-300 flex flex-col h-[120px] sm:h-[130px] md:h-[150px] cursor-pointer"
                          data-category={item.category}
                          data-menu-type={item.menuType || ""}
                        >
                          <div class="flex flex-col gap-1 flex-grow items-start text-left">
                            <h3 class="text-[13px] sm:text-sm md:text-base font-black text-black group-hover:text-yellow-600 transition-colors leading-snug line-clamp-2">
                              {item.name}
                            </h3>
                            <p class="text-slate-600 font-normal leading-[1.35] text-[11px] md:text-[13px] line-clamp-2 md:line-clamp-3 mt-1 mb-1.5 md:mt-1.5 md:mb-4">
                              {item.description}
                            </p>
                          </div>
                          
                          <div class="mt-auto flex flex-wrap items-center justify-end w-full pt-1.5 md:pt-3">
                            <span 
                              class="text-yellow-500 font-black px-1 py-1 text-[13px] md:text-[15px] text-right inline-block break-words max-w-full"
                              set:html={item.price.replace(" | ", "<br/>")}
                            ></span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>
            

          </>
        )
      }
    </div>
  </section>

  {/* Standardized Information Sections */}
  <section class="border-t border-slate-100 pt-10 pb-8">
    <div class="max-w-[1000px] mx-auto px-4">
      <div class="text-center mb-12">
        <h2
          class="text-lg md:text-4xl font-black text-black mb-4 md:mb-10 text-center uppercase tracking-tight"
        >
          Detailed {brand.name} Menu Guide
        </h2>
        <div
          class="space-y-4 md:space-y-10 text-xs md:text-base text-slate-600 leading-relaxed max-w-2xl mx-auto opacity-80"
        >
          <p>
