  {/* Client Side Scroll & Interaction Logic */}
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const typeBtns = document.querySelectorAll(".type-btn");
      const filterBtns = document.querySelectorAll(".filter-btn");
      const scrollContainer = document.getElementById("category-filter-container");
      const scrollLeftBtn = document.getElementById("scroll-left");
      const scrollRightBtn = document.getElementById("scroll-right");
      const menuItems = document.querySelectorAll(".menu-item");
      const categorySections = document.querySelectorAll(".menu-category-section");

      let currentMenuType = "";

      // Menu Type Filter Logic
      const applyMenuTypeFilter = () => {
        // 1. Update Type Button Styling
        typeBtns.forEach((b) => {
          if (b.getAttribute("data-menu-type") === currentMenuType) {
            b.classList.add("border-yellow-400", "bg-yellow-50", "text-yellow-700");
            b.classList.remove("border-slate-100", "bg-white", "text-slate-600");
          } else {
            b.classList.remove("border-yellow-400", "bg-yellow-50", "text-yellow-700");
            b.classList.add("border-slate-100", "bg-white", "text-slate-600");
          }
        });

        // 2. Show/Hide Items based on Menu Type
        menuItems.forEach((item) => {
          const itemType = item.getAttribute("data-menu-type");
          if (!currentMenuType || itemType === currentMenuType) {
            item.style.display = "flex";
          } else {
            item.style.display = "none";
          }
        });

        // 3. Hide Empty Categories and their respective top-nav buttons
        categorySections.forEach((section) => {
          const visibleItems = section.querySelectorAll('.menu-item[style="display: flex;"]');
          const catId = section.getAttribute("id");
          const btnMatch = Array.from(filterBtns).find(btn => {
            const cat = btn.getAttribute("data-category");
            return `category-${cat.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}` === catId;
          });

          // Also account for elements that might not have inline display styles initially
          let hasVisible = false;
          section.querySelectorAll('.menu-item').forEach(item => {
            if (item.style.display !== "none") hasVisible = true;
          });

          if (!hasVisible && currentMenuType !== "") {
            section.style.display = "none";
            if (btnMatch) btnMatch.style.display = "none";
          } else {
            section.style.display = "block";
            if (btnMatch) btnMatch.style.display = "inline-block";
          }
        });
      };

      typeBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const type = btn.getAttribute("data-menu-type");
          if (currentMenuType === type) {
            currentMenuType = ""; // Toggle off
          } else {
            currentMenuType = type;
          }
          applyMenuTypeFilter();
        });
      });
      
      // Initialize if type buttons exist
      if (typeBtns.length > 0) {
        currentMenuType = typeBtns[0].getAttribute("data-menu-type");
        applyMenuTypeFilter();
      }

      // Set active visual state
      const setActiveTab = (category) => {
        filterBtns.forEach((b) => {
          b.classList.remove(
            "active",
            "text-slate-900",
            "font-black",
            "border-yellow-400",
          );
          b.classList.add("text-slate-500", "font-bold", "border-transparent");
          
          if (b.getAttribute("data-category") === category) {
            b.classList.add(
              "active",
              "text-slate-900",
              "font-black",
              "border-yellow-400",
            );
            b.classList.remove("text-slate-500", "font-bold", "border-transparent");
            // Scroll the sticky bar to show the active button
            if (b.style.display !== "none") {
                b.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          }
        });
      };

      // Click to scroll
      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const cat = btn.getAttribute("data-category");
          
          if (cat === "all") {
             window.scrollTo({top: 0, behavior: "smooth"});
             setActiveTab("all");
          } else {
             const sectionId = `category-${cat.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`;
             const section = document.getElementById(sectionId);
             if (section) {
               // The scroll-mt-32 utility handles the offset for sticky header
               section.scrollIntoView({ behavior: "smooth", block: "start" });
             }
             setActiveTab(cat);
          }
        });
      });

      // Horizontal Navigation Arrows
      if (scrollContainer && scrollLeftBtn && scrollRightBtn) {
        const updateScrollButtons = () => {
          // Add a small buffer to avoid rounding issues
          if (scrollContainer.scrollLeft <= 2) {
            scrollLeftBtn.classList.add("opacity-40", "pointer-events-none", "bg-slate-50");
          } else {
            scrollLeftBtn.classList.remove("opacity-40", "pointer-events-none", "bg-slate-50");
          }
          
          if (Math.ceil(scrollContainer.scrollLeft + scrollContainer.clientWidth) >= scrollContainer.scrollWidth - 2) {
            scrollRightBtn.classList.add("opacity-40", "pointer-events-none", "bg-slate-50");
          } else {
            scrollRightBtn.classList.remove("opacity-40", "pointer-events-none", "bg-slate-50");
          }
        };

        scrollContainer.addEventListener("scroll", updateScrollButtons);
        window.addEventListener("resize", updateScrollButtons);
        // Delay to allow initial render
        setTimeout(updateScrollButtons, 100);

        scrollLeftBtn.addEventListener("click", () => {
          scrollContainer.scrollBy({ left: -250, behavior: "smooth" });
        });
        scrollRightBtn.addEventListener("click", () => {
          scrollContainer.scrollBy({ left: 250, behavior: "smooth" });
        });
      }

      // Scroll Spy using IntersectionObserver
      const sections = document.querySelectorAll(".menu-category-section");
      
      const observerOptions = {
        root: null,
        rootMargin: "-20% 0px -70% 0px", // Trigger when section is in upper third of screen
        threshold: 0
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            const activeBtn = Array.from(filterBtns).find(btn => {
              const cat = btn.getAttribute("data-category");
              return `category-${cat.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}` === id;
            });
            
            if (activeBtn) {
              const catAttr = activeBtn.getAttribute("data-category");
              setActiveTab(catAttr);
            }
          }
        });
      }, observerOptions);

      sections.forEach(section => {
        observer.observe(section);
      });

      // Set initial active tab based on scroll position (default to "all" if at top)
      if (window.scrollY < 100) {
        setActiveTab("all");
      }
    });
  </script>

